metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_5f68b"]
script = ExtResource("6_ssfod")
step_type = 18
actor_key = "mayor"
overhead_text = "..."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_ev78m"]
script = ExtResource("8_fkqmf")
text = "We took its plenty for granted."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_kkw1m"]
script = ExtResource("8_fkqmf")
text = "And little by little, there was less to give."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_ty7tv"]
