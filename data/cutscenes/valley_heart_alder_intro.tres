[sub_resource type="Resource" id="Resource_v2gqw"]
script = ExtResource("6_ssfod")
step_type = 2
dialogue_sequence = SubResource("Resource_hrpyx")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_88xqv"]
script = ExtResource("6_ssfod")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_pppd8"]
script = ExtResource("8_fkqmf")
text = "Water ran freely. Trees bent under the weight of their fruit."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_bsgy4"]
script = ExtResource("8_fkqmf")
text = "Even the smallest patches of earth seemed eager to grow."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_nwcug"]
script = ExtResource("9_1v5xo")
beats = Array[ExtResource("8_fkqmf")]([SubResource("Resource_pppd8"), SubResource("Resource_bsgy4")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_sgt1d"]
script = ExtResource("6_ssfod")
step_type = 2
dialogue_sequence = SubResource("Resource_nwcug")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_4j5sh"]
script = ExtResource("6_ssfod")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_v86cb"]
script = ExtResource("8_fkqmf")
text = "Critters gathered here first, they say."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_ovh0h"]
script = ExtResource("8_fkqmf")
text = "And where life gathered… folk eventually followed."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_t6v0e"]
script = ExtResource("8_fkqmf")
text = "Homes became paths."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_fu77t"]
script = ExtResource("8_fkqmf")
text = "Paths became a village."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_884di"]
script = ExtResource("9_1v5xo")
