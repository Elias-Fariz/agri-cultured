metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_8b5ni"]
script = ExtResource("8_fkqmf")
text = "My family kept stories of this place."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_g3ldk"]
script = ExtResource("8_fkqmf")
text = "They said the Heart answered care with care."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_y3yip"]
script = ExtResource("8_fkqmf")
text = "Hmm..."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_yy68n"]
script = ExtResource("8_fkqmf")
text = "I always thought that was only a way of speaking."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_v8rwk"]
script = ExtResource("8_fkqmf")
text = "Perhaps I was wrong."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

