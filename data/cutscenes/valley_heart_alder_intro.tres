[sub_resource type="Resource" id="Resource_62wbp"]
script = ExtResource("8_fkqmf")
text = "All this time..."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_yn6rl"]
script = ExtResource("8_fkqmf")
text = "The old stories say this valley was once far more generous than the place you found."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_hrpyx"]
script = ExtResource("9_1v5xo")
