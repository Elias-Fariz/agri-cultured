[sub_resource type="Resource" id="Resource_16rx0"]
script = ExtResource("6_ssfod")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_x7v51"]
script = ExtResource("8_fkqmf")
text = "But somewhere along the way… we became accustomed to what the valley gave."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_4mjqb"]
script = ExtResource("9_1v5xo")
beats = Array[ExtResource("8_fkqmf")]([SubResource("Resource_x7v51")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_bedyi"]
