[sub_resource type="Resource" id="Resource_l5eaj"]
script = ExtResource("8_cmpra")
text = "Oh."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_28fei"]
script = ExtResource("8_cmpra")
text = "You must be the traveler staying at the old mansion."
speaker_id = "npc_maren"
emotion = "thinking"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_i60no"]
script = ExtResource("8_cmpra")
text = "I was wondering when I might meet you."
speaker_id = "npc_maren"
emotion = "happy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_tkupv"]
script = ExtResource("8_cmpra")
text = "I’m Maren."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_jr2qd"]
script = ExtResource("8_cmpra")
text = "I keep the bakery here."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_78ruq"]
script = ExtResource("8_cmpra")
text = "You’ve been settling in, then?"
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_4u3ih"]
script = ExtResource("9_i60no")
