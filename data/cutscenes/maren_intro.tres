metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_1as0k"]
script = ExtResource("6_qvxdt")
step_type = 19
narration_text = "You tell her you’ve been working the old field beside the mansion."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_gpqun"]
script = ExtResource("8_cmpra")
text = "So I’ve heard."
speaker_id = "npc_maren"
emotion = "thinking"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_8suya"]
script = ExtResource("8_cmpra")
text = "Alder said you’d decided to stay awhile."
speaker_id = "npc_maren"
emotion = "thinking"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_uwbw1"]
script = ExtResource("8_cmpra")
text = "And I imagine Tansy has already made certain you’re properly equipped."
speaker_id = "npc_maren"
emotion = "thinking"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_61faj"]
script = ExtResource("8_cmpra")
text = "That sounds like the two of them."
speaker_id = "npc_maren"
emotion = "happy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_bm252"]
script = ExtResource("9_i60no")
beats = Array[ExtResource("8_cmpra")]([SubResource("Resource_gpqun"), SubResource("Resource_8suya"), SubResource("Resource_uwbw1"), SubResource("Resource_61faj")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_72ft6"]
script = ExtResource("6_qvxdt")
step_type = 2
dialogue_sequence = SubResource("Resource_bm252")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_jfi2j"]
script = ExtResource("6_qvxdt")
step_type = 18
actor_key = "maren"
overhead_text = "*happy*"
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_f320y"]
script = ExtResource("8_cmpra")
text = "You needn’t hurry to make yourself useful, though."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_vh5vr"]
script = ExtResource("8_cmpra")
text = "A new place takes time to feel familiar."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_4b8dk"]
script = ExtResource("8_cmpra")
text = "The bakery isn’t quite ready for visitors today."
speaker_id = "npc_maren"
emotion = "thinking"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_evc4v"]
script = ExtResource("8_cmpra")
text = "But give me a little time, and you’re welcome to stop in."
speaker_id = "npc_maren"
emotion = "happy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_ncgby"]
script = ExtResource("8_cmpra")
text = "If you ever decide you’d like to learn your way around a kitchen, I can help with that too."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_n7knj"]
script = ExtResource("8_cmpra")
text = "A good meal can do more than fill you up."
speaker_id = "npc_maren"
emotion = "thinking"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_0olr6"]
script = ExtResource("8_cmpra")
text = "For now… enjoy the morning."
speaker_id = "npc_maren"
emotion = "happy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_fuhwf"]
script = ExtResource("8_cmpra")
text = "There are plenty of little things worth noticing around here."
speaker_id = "npc_maren"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

