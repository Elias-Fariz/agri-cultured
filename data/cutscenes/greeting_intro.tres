[sub_resource type="Resource" id="Resource_xo77u"]
script = ExtResource("6_2pgpd")
text = "Ah. There you are."
speaker_id = "npc_mayor"
speaker_name_override = "???"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_occxa"]
script = ExtResource("6_2pgpd")
text = "How did you sleep? You came by rather late last night. I hope the old house kept you warm enough."
speaker_id = "npc_mayor"
speaker_name_override = "???"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_27yug"]
script = ExtResource("6_2pgpd")
text = "I was beginning to wonder whether you'd be awake before I finished my morning walk."
speaker_id = "npc_mayor"
speaker_name_override = "???"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_yopxa"]
script = ExtResource("7_cag78")
beats = Array[ExtResource("6_2pgpd")]([SubResource("Resource_xo77u"), SubResource("Resource_occxa"), SubResource("Resource_27yug")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_a08rt"]
script = ExtResource("4_2pgpd")
step_type = 2
dialogue_sequence = SubResource("Resource_yopxa")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_fomr5"]
script = ExtResource("4_2pgpd")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_vp7ds"]
script = ExtResource("4_2pgpd")
step_type = 2
speaker_actor_key = "mayor"
speaker_name = "???"
lines = Array[String](["Well... I imagine you'll be wanting the road again before long.", "If you're moving on this morning, I hope the weather treats you kindly."])
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_fbapq"]
script = ExtResource("4_2pgpd")
step_type = 19
narration_text = "You tell Mayor Alder that you aren't quite ready to leave."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_4m285"]
script = ExtResource("4_2pgpd")
step_type = 19
narration_text = "You mention the strange voice you heard during the night."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_law8i"]
script = ExtResource("4_2pgpd")
step_type = 2
speaker_actor_key = "mayor"
speaker_name = "???"
lines = Array[String](["A voice?"])
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_sqiqa"]
script = ExtResource("4_2pgpd")
step_type = 18
actor_key = "mayor"
duration = 0.8
overhead_text = "..."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_mk68a"]
script = ExtResource("4_2pgpd")
step_type = 2
speaker_actor_key = "mayor"
speaker_name = "???"
lines = Array[String](["Hmm...", "I may have an idea of what you've heard."])
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_ybhbr"]
script = ExtResource("4_2pgpd")
step_type = 2
speaker_actor_key = "mayor"
speaker_name = "???"
lines = Array[String](["There are old stories about this valley. Older than most of the houses still standing.", "But I would rather not turn an old story into an answer before we know what we're looking for."])
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_ylt7b"]
script = ExtResource("4_2pgpd")
step_type = 19
narration_text = "You tell him you'd like to stay for a little while and find out for yourself."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_js58o"]
script = ExtResource("4_2pgpd")
step_type = 2
speaker_actor_key = "mayor"
speaker_name = "???"
lines = Array[String](["Then stay.", "There's no harm in giving yourself a little time.", "If the valley has something to say, perhaps you'll hear it more clearly once you've had a chance to settle in."])
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_nvnr7"]
script = ExtResource("6_2pgpd")
text = "Ah... and if we're to be neighbors, I suppose I ought to introduce myself properly."
speaker_id = "npc_mayor"
speaker_name_override = "???"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_qslkh"]
script = ExtResource("6_2pgpd")
text = "Alder. Mayor Alder, if we're being official about it."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_et8yo"]
script = ExtResource("6_2pgpd")
text = "We rarely are."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_m7dle"]
script = ExtResource("7_cag78")
beats = Array[ExtResource("6_2pgpd")]([SubResource("Resource_nvnr7"), SubResource("Resource_qslkh"), SubResource("Resource_et8yo")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_28f6d"]
script = ExtResource("4_2pgpd")
step_type = 2
dialogue_sequence = SubResource("Resource_m7dle")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_rgkrw"]
script = ExtResource("6_2pgpd")
text = "No one's lived in the old mansion for some time, but we keep it mended as best we can."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_rjh87"]
script = ExtResource("6_2pgpd")
text = "If you're comfortable there, you're welcome to use it for as long as you'd like."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_15wmu"]
script = ExtResource("6_2pgpd")
text = "There's an old growing plot beside the house, too."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_qvj8p"]
script = ExtResource("6_2pgpd")
text = "It hasn't seen much work lately... but the soil still looks willing."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_shiby"]
script = ExtResource("6_2pgpd")
text = "If you're staying awhile, growing something might be a pleasant way to settle in."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_es66d"]
script = ExtResource("7_cag78")
beats = Array[ExtResource("6_2pgpd")]([SubResource("Resource_rgkrw"), SubResource("Resource_rjh87"), SubResource("Resource_15wmu"), SubResource("Resource_qvj8p"), SubResource("Resource_shiby")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_84ict"]
script = ExtResource("4_2pgpd")
step_type = 2
dialogue_sequence = SubResource("Resource_es66d")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_168ns"]
script = ExtResource("6_2pgpd")
text = "You'll find Tansy's general store east of here."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_svute"]
script = ExtResource("6_2pgpd")
text = "They should have seeds for sale."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_6er40"]
script = ExtResource("6_2pgpd")
text = "And unless my memory has finally betrayed me, there's a box of old tools somewhere in that shop that could use a new home."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_dx3ul"]
script = ExtResource("7_cag78")
beats = Array[ExtResource("6_2pgpd")]([SubResource("Resource_168ns"), SubResource("Resource_svute"), SubResource("Resource_6er40")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_ngyyp"]
script = ExtResource("4_2pgpd")
step_type = 2
dialogue_sequence = SubResource("Resource_dx3ul")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_3r3to"]
script = ExtResource("4_2pgpd")
step_type = 19
narration_text = "Mayor Alder reaches into his pocket and presses a small coin pouch into your hands."
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_1f7un"]
script = ExtResource("6_2pgpd")
text = "Here. It isn't much, but it should help you get started."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_4h0gq"]
script = ExtResource("6_2pgpd")
text = "The town is just east along the path."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_mk0f3"]
script = ExtResource("6_2pgpd")
text = "Take your time. Tansy's not going anywhere."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_dpki2"]
script = ExtResource("7_cag78")
beats = Array[ExtResource("6_2pgpd")]([SubResource("Resource_1f7un"), SubResource("Resource_4h0gq"), SubResource("Resource_mk0f3")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_qniw4"]
