step_type = 2
dialogue_sequence = SubResource("Resource_dpki2")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_0o4my"]
script = ExtResource("6_2pgpd")
text = "We're a small bunch... but I think you'll find there's room here for one more."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

