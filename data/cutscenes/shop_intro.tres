metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_bhqkw"]
script = ExtResource("4_3pc4l")
step_type = 19
narration_text = "But... for free?"
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_787nl"]
script = ExtResource("6_n142m")
text = "You can take them."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_chuka"]
script = ExtResource("6_n142m")
text = "They’ve been sitting there for years."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_fwp7j"]
script = ExtResource("6_n142m")
text = "Tools are meant to be used."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_segj5"]
script = ExtResource("6_n142m")
text = "You’ll still need seeds, of course."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_mrqb4"]
script = ExtResource("6_n142m")
text = "Those, unfortunately, I do have to charge for."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_y6u7e"]
script = ExtResource("6_n142m")
text = "A shop does have to remain a shop."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_n7naj"]
script = ExtResource("7_bmkam")
beats = Array[ExtResource("6_n142m")]([SubResource("Resource_787nl"), SubResource("Resource_chuka"), SubResource("Resource_fwp7j"), SubResource("Resource_segj5"), SubResource("Resource_mrqb4"), SubResource("Resource_y6u7e")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_k7xcq"]
script = ExtResource("4_3pc4l")
step_type = 2
dialogue_sequence = SubResource("Resource_n7naj")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_b2r0l"]
script = ExtResource("4_3pc4l")
step_type = 18
actor_key = "player"
overhead_text = "*grumble*"
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_iilrk"]
script = ExtResource("6_n142m")
text = "I keep food as well."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_c17fv"]
script = ExtResource("6_n142m")
text = "If you wear yourself out working, eat something before you keep going."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_evisd"]
script = ExtResource("6_n142m")
text = "You can't do much work on an empty stomach."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_plmjb"]
script = ExtResource("6_n142m")
text = "Believe me. I know."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_xbq2m"]
script = ExtResource("7_bmkam")
beats = Array[ExtResource("6_n142m")]([SubResource("Resource_iilrk"), SubResource("Resource_c17fv"), SubResource("Resource_evisd"), SubResource("Resource_plmjb")])
metadata/_custom_type_script = "uid://clb3lhdggkt8d"

[sub_resource type="Resource" id="Resource_tdhkf"]
script = ExtResource("4_3pc4l")
step_type = 2
dialogue_sequence = SubResource("Resource_xbq2m")
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_5yida"]
script = ExtResource("6_n142m")
text = "And if you grow more than you need, there’s a shipping bin just outside."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_wlkfy"]
script = ExtResource("6_n142m")
text = "Leave anything you want to sell there, and I’ll settle the account the next morning."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_8wse8"]
