[sub_resource type="Resource" id="Resource_pw8v2"]
script = ExtResource("6_n142m")
text = "Oh!"
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_2xy4m"]
script = ExtResource("6_n142m")
text = "You're the traveler staying at the old mansion!"
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_kymw0"]
script = ExtResource("6_n142m")
text = "Right. Yes. That makes considerably more sense."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_uck6j"]
script = ExtResource("6_n142m")
text = "Sorry. News travels quickly here, but apparently not quite quickly enough."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_66ppe"]
