duration = 1.0
overhead_text = "...?"
metadata/_custom_type_script = "uid://0k0f68wqa7mm"

[sub_resource type="Resource" id="Resource_20e1k"]
script = ExtResource("6_n142m")
text = "Though..."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_a2tm0"]
script = ExtResource("6_n142m")
text = "I don’t think I’ve seen you before."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_d6nr8"]
script = ExtResource("6_n142m")
text = "And I generally remember customers."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_1u4pl"]
