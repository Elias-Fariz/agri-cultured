metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_nxycu"]
script = ExtResource("6_n142m")
text = "There’s an old set by the side wall."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_b0dgr"]
script = ExtResource("6_n142m")
text = "Second crate down. Left side. Under the twine."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_dbg5k"]
script = ExtResource("6_n142m")
