[sub_resource type="Resource" id="Resource_t3wsm"]
script = ExtResource("6_n142m")
text = "Right. Hello."
speaker_id = "npc_tansy"
speaker_name_override = "???"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_breae"]
script = ExtResource("6_n142m")
text = "Welcome to the general store."
speaker_id = "npc_tansy"
speaker_name_override = "???"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_ui7ku"]
script = ExtResource("6_n142m")
text = "I'm Tansy."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_3po4l"]
script = ExtResource("6_n142m")
text = "Seeds, food, household goods, odds and ends… if it can be stacked, labeled, counted, or sold, I probably have some version of it."
speaker_id = "npc_tansy"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_x4xq0"]
