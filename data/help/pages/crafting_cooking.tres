script = ExtResource("1_abt2f")
page_id = "crafting_cooking"
title = "Crafting and Cooking"
unlock_flag = "help_page:crafting_cooking"
locked_until_flag = true
body = "Some useful things can be made from gathered materials.

Crafting turns simple items into something helpful or heartfelt. Cooking can restore energy and may give small blessings for the day.

[b]Tip:[/b] Discover recipes through quests, friendship, or just wandering the world."
