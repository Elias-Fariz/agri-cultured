[resource]
script = ExtResource("1_6mq20")
page_id = "farming_basics"
title = "Farming Basics"
body = "To grow crops, till the soil, plant your seeds, and then water them.

Crops usually need care across several days before they are ready to harvest, so make sure to tend them constantly. Rain can help water the land for you.

[b]Tip:[/b] Till → Plant → Water → Wait → Harvest."
metadata/_custom_type_script = "uid://ex3ariy65b4m"
