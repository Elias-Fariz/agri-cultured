script = ExtResource("1_y2lx3")
page_id = "friendship"
title = "Friendship"
unlock_flag = "help_page:friendship"
locked_until_flag = true
body = "Friendship grows through kindness.

Talking, helping, and giving thoughtful gifts can bring you closer to the people of the valley. Some villagers may enjoy certain gifts more than others.

[b]Tip:[/b] Listen out to dialogue to learn which gifts villagers like better."
