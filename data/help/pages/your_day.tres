[resource]
script = ExtResource("1_kg4dj")
page_id = "your_day"
title = "Your Day"
body = "Each day begins in the morning.

You can tend your farm, visit town, talk with villagers, gather items, craft, shop, or explore open paths.

When you are ready, return home and rest for the next day.

[b]Tip:[/b] Sleeping in your bed starts a new day. And try not to stay up after 2AM..."
metadata/_custom_type_script = "uid://ex3ariy65b4m"
