metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_q6oya"]
script = ExtResource("2_cegjg")
text = "Here. Let me show you."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_x1buf"]
script = ExtResource("2_cegjg")
text = "Once you've made one, perhaps Maren might enjoy it."
speaker_id = "npc_mayor"
metadata/_custom_type_script = "uid://dt1fjl76x6n5o"

[sub_resource type="Resource" id="Resource_2qs0u"]
