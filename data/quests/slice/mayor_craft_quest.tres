turn_in_lines = Array[String](["These are some beautful flowers! Good work.", "Now, just give me a couple moments as I...", "Yep, still got it!", "Here is your flower headband! Doesn't it look good on you?"])
after_thanks_lines = Array[String](["Maybe I'll give you the recipe so that you can make headbands yourself...", "Ahh, maybe another day."])
