[resource]
script = ExtResource("3_5amai")
id = "fisher_craft_quest"
title = "Crafting a Gift"
description = "These flowers look lovely! Maybe we could turn them into something fashionable..."
quest_type = "chain"
oneshot_action = ""
steps = Array[ExtResource("4_avcty")]([SubResource("Resource_f8u51"), SubResource("Resource_o1cdf")])
turn_in_id = "npc_mayor"
turn_in_text = "Go show the Mayor your beautiful creation!"
reward_money = 100
reward_flags = Array[String](["help_page:friendship"])
accept_reward_flags = Array[String](["help_page:crafting_cooking"])
accept_reward_crafting_recipe_ids = Array[String](["flower_headband"])
requires_day = 2
offer_lines = Array[String](["Have you noticed those lovely flowers between your farm and the town?", "They could make a lovely headband.", "Would you like to try making one? I have the recipe right here."])
in_progress_lines = Array[String](["You can pick items off the floor with E.", "And to access the crafting menu, click C."])
turn_in_lines = Array[String](["This headband is beautifully crafted, good work!", "You know, this would be a lovely gift for another villager.", "Just walk up to someone and press G. Gifting is a wonderful way to increase your friendship.", "And there's no rush at all. The world is your oyster, and you've just started your journey..."])
after_thanks_lines = Array[String](["Thinking about giving the flower headband to me?", "Remember, press G and then select the gift you want to present."])
